{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".nvmrc", "rust-toolchain.toml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {},
    "format:check": {},
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["DATABASE_URL"]
    }
  }
}
