# Copy to .env and choose your own values. .env is ignored by git: never commit it.

# Local PostgreSQL started by `pnpm db:up` (compose.yaml).
POSTGRES_USER=portflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portflow
# Port on 127.0.0.1; change it if 5432 is already taken.
POSTGRES_PORT=5432

# Connection string of the API and of its tests. Keep it in line with the values above.
DATABASE_URL=postgres://portflow:change-me@localhost:5432/portflow

# Address the API listens on (`pnpm --filter @portflow/api start`): a host and a port,
# with no scheme.
API_ADDRESS=127.0.0.1:8080
# URL the web app forwards `/api` to (`vite` and `vite preview`) and that the end-to-end
# tests wait for: the API seen from outside, with its scheme. Locally it is the address
# above over http; once deployed behind TLS it is an https URL.
API_URL=http://127.0.0.1:8080

# Logs of the API, on its standard output. `pretty`: one readable line per event, for
# local development. `json`: one JSON object per line, and the format when the
# variable is not set, as everywhere else than on a developer's machine.
LOG_FORMAT=pretty
# Level of the logs: error, warn, info or debug, or the filters of `tracing`
# (`info,sqlx=debug`). `info` when it is not set.
# RUST_LOG=info
