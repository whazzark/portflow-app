# Copy to .env and choose your own values. .env is ignored by git: never commit it.

# Local PostgreSQL started by `pnpm db:up` (compose.yaml).
POSTGRES_USER=portflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portflow
# Port on 127.0.0.1; change it if 5432 is already taken.
POSTGRES_PORT=5432

# Connection string of the API and of its tests. Keep it in line with the values above.
DATABASE_URL=postgres://portflow:change-me@localhost:5432/portflow
