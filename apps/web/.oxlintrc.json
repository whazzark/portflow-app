{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": ["dist/**", "src/routeTree.gen.ts"],
  "rules": {
    "import/no-cycle": "error",
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^(\\.\\./){2,}",
            "message": "Import from another folder of src through the alias @/, not with ../../"
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/array-type": ["error", { "default": "array", "readonly": "generic" }],
    "react/function-component-definition": [
      "error",
      {
        "namedComponents": "function-declaration",
        "unnamedComponents": "arrow-function"
      }
    ],
    "react/prefer-function-component": "error"
  },
  "overrides": [
    {
      "files": ["src/shared/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./){2,}",
                "message": "Import from another folder of src through the alias @/, not with ../../"
              },
              {
                "regex": "^@/(app|routes|features)(/|$)",
                "message": "shared imports nothing above it: app, routes and features import shared, never the other way"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./){2,}",
                "message": "Import from another folder of src through the alias @/, not with ../../"
              },
              {
                "regex": "^@/(app|routes|features)(/|$)",
                "message": "A feature imports shared only, never app, routes or another feature; inside the feature, import relatively"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/components/**", "src/features/*/*-page.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./){2,}",
                "message": "Import from another folder of src through the alias @/, not with ../../"
              },
              {
                "regex": "^@/(app|routes|features)(/|$)",
                "message": "A feature imports shared only, never app, routes or another feature; inside the feature, import relatively"
              },
              {
                "regex": "^@/shared/api(/|$)",
                "message": "Components reach the API through the queries of their feature"
              }
            ],
            "paths": [
              {
                "name": "@portflow/contracts",
                "message": "Generated API types stay in api/ and model/: components use screen types"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./){2,}",
                "message": "Import from another folder of src through the alias @/, not with ../../"
              },
              {
                "regex": "^@/app(/|$)",
                "message": "routes never import app"
              },
              {
                "regex": "^@/features/[^/]+/(model|components|hooks|constants)(/|$)",
                "message": "A route imports the page of a feature and its queries (api/) only"
              },
              {
                "regex": "^@/shared/api(/|$)",
                "message": "Components reach the API through the queries of their feature"
              }
            ],
            "paths": [
              {
                "name": "@portflow/contracts",
                "message": "Generated API types stay in api/ and model/: components use screen types"
              }
            ]
          }
        ]
      }
    }
  ]
}
