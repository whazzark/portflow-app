{
  "openapi": "3.1.0",
  "info": {
    "title": "Portflow API",
    "description": "Bulk discharge management for the operating organization of a port site",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health of the service and of its database.",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "The service and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "detail": "The server could not handle the request",
                  "status": 500,
                  "title": "Internal Server Error",
                  "type": "about:blank"
                }
              }
            }
          },
          "503": {
            "description": "The database does not answer",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "example": {
                  "code": "DATABASE_UNAVAILABLE",
                  "detail": "The database does not answer",
                  "status": 503,
                  "title": "Service Unavailable",
                  "type": "about:blank"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentStatus": {
        "type": "string",
        "enum": [
          "up",
          "down"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "$ref": "#/components/schemas/ComponentStatus"
          },
          "status": {
            "$ref": "#/components/schemas/ComponentStatus",
            "description": "`up` when every component is up."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "The body of every error response of the API.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "type": "string",
            "description": "An explanation in English for the developer, never shown to the user."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code of the response.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "The reason phrase of the status code."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`: `code` identifies the error."
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "description": "The stable identifier of an error. The web app maps each value to a French label:\na value is never renamed or removed without the two issues of a contract change.",
        "enum": [
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "INVALID_REQUEST",
          "DATABASE_UNAVAILABLE",
          "INTERNAL_ERROR"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Health of the service"
    }
  ]
}
