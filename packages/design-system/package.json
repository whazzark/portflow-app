{
  "name": "@portflow/design-system",
  "private": true,
  "type": "module",
  "exports": {
    "./atoms/*": "./src/atoms/*.tsx",
    "./molecules/*": "./src/molecules/*.tsx",
    "./templates/*": "./src/templates/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles/constants": "./src/styles/constants.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build": "tsc -p . && storybook build --quiet --output-dir storybook-static",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "storybook": "storybook dev --port 6006",
    "build:claude-design": "node scripts/claude-design/build.ts"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.71.0",
    "radix-ui": "1.8.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
